{
  "entities": {
    "vehicle": {
      "title": "Vehicle Record",
      "description": "Represents a vehicle parked or previously parked in the lot.",
      "type": "object",
      "properties": {
        "plateNumber": {
          "type": "string",
          "description": "Standard license plate number.",
          "maxLength": 32
        },
        "vehicleType": {
          "type": "string",
          "description": "Category of vehicle.",
          "enum": ["Car", "SUV", "Motorcycle", "Bus", "Truck"]
        },
        "ownerPhone": {
          "type": "string",
          "description": "Phone number for digital receipts.",
          "maxLength": 32
        },
        "entryTime": {
          "type": "string",
          "description": "ISO 8601 timestamp of entry."
        },
        "exitTime": {
          "type": "string",
          "description": "ISO 8601 timestamp of exit."
        },
        "durationMinutes": {
          "type": "number",
          "description": "Total parked duration in minutes."
        },
        "fee": {
          "type": "number",
          "description": "Calculated or paid parking fee in INR."
        },
        "status": {
          "type": "string",
          "description": "Current parking status.",
          "enum": ["Parked", "Exited"]
        },
        "paymentStatus": {
          "type": "string",
          "description": "Payment settlement status.",
          "enum": ["Paid", "Unpaid"]
        },
        "paymentMethod": {
          "type": "string",
          "description": "Payment instrument.",
          "enum": ["Cash", "UPI", "Card"]
        },
        "receiptNumber": {
          "type": "string",
          "description": "Unique receipt identifier.",
          "maxLength": 64
        },
        "loggedBy": {
          "type": "string",
          "description": "Staff member or system operator.",
          "maxLength": 128
        },
        "rateAppliedAtEntry": {
          "type": "number",
          "description": "Base rate applied at entry time."
        },
        "graceMinutesAtEntry": {
          "type": "number",
          "description": "Grace minutes policy at entry."
        },
        "minimumChargeAtEntry": {
          "type": "number",
          "description": "Minimum fee policy at entry."
        }
      },
      "required": ["plateNumber", "vehicleType", "entryTime", "fee", "status", "paymentStatus", "loggedBy"]
    },
    "settings": {
      "title": "Lot Settings",
      "description": "Global parking lot operating settings and rate configuration.",
      "type": "object",
      "properties": {
        "lotName": {
          "type": "string",
          "description": "Name of the parking facility.",
          "maxLength": 128
        },
        "hourlyRate": {
          "type": "number",
          "description": "Base rate per hour in INR."
        },
        "minimumCharge": {
          "type": "number",
          "description": "Minimum billable charge in INR."
        },
        "gracePeriodMinutes": {
          "type": "number",
          "description": "Initial free grace period in minutes."
        },
        "lastUpdatedBy": {
          "type": "string",
          "description": "Name of the administrator who made changes.",
          "maxLength": 128
        },
        "lastUpdatedAt": {
          "type": "string",
          "description": "Display timestamp of latest modification.",
          "maxLength": 128
        }
      },
      "required": ["lotName", "hourlyRate", "minimumCharge", "gracePeriodMinutes"]
    },
    "gateActivity": {
      "title": "Gate Activity Entry",
      "description": "Real-time audit log of gate transactions.",
      "type": "object",
      "properties": {
        "timestamp": {
          "type": "string",
          "description": "ISO timestamp of the activity."
        },
        "timeFormatted": {
          "type": "string",
          "description": "Formatted time string (e.g. 13:45)."
        },
        "plateNumber": {
          "type": "string",
          "description": "License plate associated with the action."
        },
        "action": {
          "type": "string",
          "description": "Type of event.",
          "enum": ["entered", "exited"]
        },
        "vehicleType": {
          "type": "string",
          "description": "Vehicle type classification."
        },
        "fee": {
          "type": "number",
          "description": "Fee collected on exit, if applicable."
        }
      },
      "required": ["timestamp", "plateNumber", "action", "vehicleType"]
    },
    "operatorSession": {
      "title": "Operator Session",
      "description": "Staff shift login and logout times, duration, gate assignment, and active status.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "operatorId": { "type": "string" },
        "operatorName": { "type": "string" },
        "operatorEmail": { "type": "string" },
        "operatorRole": { "type": "string", "enum": ["staff", "admin"] },
        "gate": { "type": "string" },
        "loginTime": { "type": "string", "description": "ISO timestamp of operator sign in." },
        "logoutTime": { "type": "string", "description": "ISO timestamp of operator sign out." },
        "durationMinutes": { "type": "number", "description": "Shift duration in minutes." },
        "status": { "type": "string", "enum": ["active", "completed"] },
        "vehiclesProcessed": { "type": "number" },
        "notes": { "type": "string" }
      },
      "required": ["operatorName", "loginTime", "status"]
    },
    "staffUser": {
      "title": "Staff User",
      "description": "Registered parking lot employees and administrators with gate assignments.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string", "maxLength": 128 },
        "email": { "type": "string", "maxLength": 128 },
        "role": { "type": "string", "enum": ["staff", "admin"] },
        "title": { "type": "string", "maxLength": 128 },
        "gate": { "type": "string", "maxLength": 64 },
        "phone": { "type": "string", "maxLength": 32 },
        "createdAt": { "type": "string" }
      },
      "required": ["name", "email", "role"]
    }
  },
  "firestore": {
    "/vehicles/{vehicleId}": {
      "schema": "vehicle",
      "description": "Parking sessions for all active and historical vehicles."
    },
    "/settings/{settingsId}": {
      "schema": "settings",
      "description": "Lot rates and configuration settings."
    },
    "/gate_activities/{activityId}": {
      "schema": "gateActivity",
      "description": "Live stream of entry and exit operations."
    },
    "/operator_sessions/{sessionId}": {
      "schema": "operatorSession",
      "description": "Historical and live operator shift login and logout times."
    },
    "/staff_users/{staffId}": {
      "schema": "staffUser",
      "description": "Registered employees and parking staff members."
    }
  }
}
